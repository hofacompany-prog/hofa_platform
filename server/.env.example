# Copy file này thành .env khi chạy local (KHÔNG commit .env thật lên git).
# Trên Render, khai báo các biến này trong Dashboard > Environment thay vì dùng file.

# Lấy trong Supabase: Project Settings > Database > Connection string > "Transaction" hoặc
# "Session" pooler. Vì Render chạy 1 tiến trình Node sống lâu dài (không phải serverless
# từng lần gọi), dùng chuỗi "Session pooler" (cổng 5432) là hợp lý nhất.
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Project Settings > General > Project ID → SUPABASE_URL = https://<project-id>.supabase.co
# Dùng để lấy khoá công khai (JWKS) xác minh JWT — không phải bí mật, chỉ là địa chỉ project.
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings > API > "service_role" secret (KHÔNG PHẢI "anon" key — key này bỏ qua
# mọi RLS/policy, tuyệt đối không lộ ra client). Chỉ dùng để admin tạo thẳng tài khoản chủ
# cửa hàng hoàn toàn mới kèm mật khẩu ngay lúc tạo cửa hàng (server/src/supabaseAdmin.js).
# Bỏ trống thì tính năng đó báo lỗi rõ ràng, phần còn lại của server vẫn chạy bình thường.
SUPABASE_SERVICE_ROLE_KEY=

# Tự đặt 1 chuỗi bí mật dài, ngẫu nhiên — dùng để xác minh webhook thanh toán
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-string

PORT=3000
NODE_ENV=development

# Cloudinary Dashboard > lấy 3 giá trị này ngay trang chủ dashboard.
# Dùng để SERVER ký request upload ảnh (client không bao giờ cầm API_SECRET).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Console > Project settings > Service accounts > Generate new private key
# (tải về 1 file JSON). Dán TOÀN BỘ nội dung file đó vào biến này trên 1 dòng
# (Render Dashboard > Environment cho phép value nhiều dòng, dán nguyên JSON là được).
# Dùng để server gửi push notification (FCM) cho app tài xế khi có đơn mới.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Bí mật tự đặt, dùng để bảo vệ endpoint POST /internal/sweep-expired-offers —
# gọi định kỳ (vd Render Cron Job mỗi 15-20s) để tự chuyển đơn sang tài xế khác
# khi tài xế hiện tại không xác nhận kịp accept_deadline.
INTERNAL_SWEEP_SECRET=change-me-to-a-long-random-string
